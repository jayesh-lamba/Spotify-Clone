{
  "services": {
    "spotify-frontend": {
      "root": ".",
      "framework": "create-react-app",
      "buildCommand": "npm run build",
      "outputDirectory": "build"
    },
    "orivio-backend": {
      "root": "backend",
      "ignoreCommand": "exit 0"
    }
  },
  "rewrites": [
    { "source": "/((?!static/).*)", "destination": "/index.html" }
  ]
}
