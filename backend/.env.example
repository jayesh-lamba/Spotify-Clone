# ORIVIO Backend — Environment Variables Template
# Copy this file to .env and fill in all values before starting the server.

PORT=5001
NODE_ENV=development

# MongoDB connection string from MongoDB Atlas or local MongoDB
MONGODB_URI=

# Secret key for signing JWTs — use a long, random, unique string in production
JWT_SECRET=

# Token expiry duration (e.g. 7d, 1d, 24h)
JWT_EXPIRES_IN=7d
