# ORIVIO Backend — Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in all values before starting.
# Never commit .env to git.
# ══════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/orivio
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/orivio
MONGODB_URI=

# ── JWT ────────────────────────────────────────────────────────────
# Use a long, random, unique string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── URLs (required in production) ──────────────────────────────────
# The public URL of this backend — used to build audioUrl and coverImage URLs
# in MongoDB after scanning.
# Example: https://orivio-api.onrender.com
BACKEND_URL=http://localhost:5001

# Comma-separated list of allowed frontend origins for CORS.
# Example: https://orivio.vercel.app,https://orivio-git-main.vercel.app
FRONTEND_URL=http://localhost:3000
